# Boş bırakılırsa yerelde gömülü veritabanı (.data/ klasörü) kullanılır.
# Yayında: Supabase / Neon Postgres bağlantı adresi (Supabase'de "Transaction pooler", port 6543).
DATABASE_URL=

# Demo hesaplarının şifresi (npm run seed bunu kullanır).
DEMO_PASSWORD=

# İsteğe bağlı: şifre sıfırlama e-postaları için Resend API anahtarı.
# Boşsa sıfırlama bağlantısı sunucu konsoluna yazılır.
RESEND_API_KEY=
MAIL_FROM=Telve <onboarding@resend.dev>
